# Application Configuration
PORT=3000
NODE_ENV=development

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://vtu_user:vtu_password@localhost:5432/vtu_db?schema=public"

# Provider APIs (Inlomax & Husmodata)
INLOMAX_API_KEY="your_inlomax_api_key"
INLOMAX_BASE_URL="https://api.inlomax.com/v1"

HUSMODATA_API_KEY="your_husmodata_api_key"
HUSMODATA_BASE_URL="https://husmodataapi.com/api"

# JWT Secret
JWT_SECRET="super-secret-jwt-key-change-in-production"
