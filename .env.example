# Application Environment Configuration
PORT=3000
NODE_ENV=development

# PostgreSQL Database Connection
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vtu_db?schema=public"

# Third-Party VTU Provider APIs
INLOMAX_API_KEY="your_inlomax_api_key"
INLOMAX_BASE_URL="https://api.inlomax.com/v1"

HUSMODATA_API_KEY="your_husmodata_api_key"
HUSMODATA_BASE_URL="https://husmodataapi.com/api"

# Strowallet Virtual Bank Account API & Webhooks
STROWALLET_PUBLIC_KEY="your_strowallet_public_key"
STROWALLET_SECRET_KEY="your_strowallet_secret_key"
STROWALLET_WEBHOOK_SECRET="your_strowallet_webhook_secret"
STROWALLET_BASE_URL="https://api.strowallet.com/v1"
STROWALLET_ALLOWED_IPS="52.208.12.44,54.72.19.112,127.0.0.1"

# Security Secrets
JWT_SECRET="super-secret-jwt-key-change-in-production"
